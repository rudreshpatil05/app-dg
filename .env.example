# Backend environment
ENVIRONMENT=development
DATABASE_URL=mysql+pymysql://dg_retail_app:Rudresh890@127.0.0.1:3306/dg_retail
SECRET_KEY=replace-with-a-long-random-secret
SEED_DATABASE=true
BACKEND_CORS_ORIGINS=http://localhost:5173

# Frontend environment
# Use the full API origin and prefix for staging/production.
VITE_API_URL=http://localhost:8000/api/v1

# Staging example:
# ENVIRONMENT=staging
# DATABASE_URL=mysql+pymysql://app_user:Rudresh890@db.example.com/dg_retail_staging
# SEED_DATABASE=false
# BACKEND_CORS_ORIGINS=https://staging.example.com
# VITE_API_URL=https://staging-api.example.com/api/v1

# Production example:
# ENVIRONMENT=production
# DATABASE_URL=mysql+pymysql://app_user:Rudresh890@db.example.com/dg_retail_production
# SECRET_KEY=replace-with-a-secret-from-your-secret-manager
# SEED_DATABASE=false
# BACKEND_CORS_ORIGINS=https://app.example.com
# VITE_API_URL=https://api.example.com/api/v1
